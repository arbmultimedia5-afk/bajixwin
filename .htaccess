<IfModule mod_rewrite.c>
RewriteEngine On

# Route /api/game/callback (without .php) to /api/game/callback.php
RewriteRule ^api/game/callback/?$ api/game/callback.php [L,QSA]
RewriteRule ^api/game/debug_callback/?$ api/game/debug_callback.php [L,QSA]
RewriteRule ^api/game/view_log/?$ api/game/view_log.php [L,QSA]
</IfModule>
